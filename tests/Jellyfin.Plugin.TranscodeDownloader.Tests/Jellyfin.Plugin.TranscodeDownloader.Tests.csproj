<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the plugin. Not part of the plugin build: they live outside src/, so the published DLL
    never sees them. Run from the repository root:
      dotnet test tests/Jellyfin.Plugin.TranscodeDownloader.Tests
    A different Jellyfin version (for an upgrade check) reaches the plugin and the tests together:
      dotnet test tests/Jellyfin.Plugin.TranscodeDownloader.Tests -p:JellyfinVersion=12.4.0
    ./build.sh runs this in the .NET SDK container before it publishes.
  -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.3.0</JellyfinVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Runs the client script's pure functions (auth header, Apple codec rule) without a browser. -->
    <PackageReference Include="Jint" Version="4.2.0" />
    <!-- The Jellyfin types the tests build or mock: the same version as the plugin. -->
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JellyfinTranscodeDownloader.csproj" />
  </ItemGroup>

</Project>
