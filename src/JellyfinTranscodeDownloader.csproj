<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Compiled against Jellyfin 12.3 (net10.0). Override with -p:JellyfinVersion=X to check
         the plugin against another server version; the tests project follows the same property. -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.3.0</JellyfinVersion>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.TranscodeDownloader</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.TranscodeDownloader</RootNamespace>
    <Version>0.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ASP.NET Core types (ControllerBase, [ApiController], etc.) for the controller. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin SDK references — not bundled into the output (provided at runtime by Jellyfin itself). -->
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinVersion)" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" PrivateAssets="All" />
    <!-- Newtonsoft JObject is the parameter type of the File Transformation plugin's
         RegisterTransformation(JObject) entry point. Jellyfin ships Newtonsoft at
         runtime, so this is reference-only (PrivateAssets=All). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- The client script and string bundles are embedded and served by
       TranscodeDownloaderController; nothing is written to disk. -->
  <ItemGroup>
    <EmbeddedResource Include="..\web\config.html">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.config.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\plugin.js">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.plugin.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\strings\en-us.json">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.strings.en-us.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\strings\de.json">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.strings.de.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\strings\fr.json">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.strings.fr.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\strings\es.json">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.strings.es.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\strings\zh-cn.json">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.strings.zh-cn.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\web\strings\nl.json">
      <LogicalName>Jellyfin.Plugin.TranscodeDownloader.web.strings.nl.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
